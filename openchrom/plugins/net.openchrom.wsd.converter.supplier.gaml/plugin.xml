<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.chemclipse.wsd.converter.chromatogramSupplier">
      <ChromatogramSupplier
            description="Reads Generalized Analytical Markup Language Chromatograms"
            fileExtension=".gaml"
            filterName="GAML WSD Chromatogram (*.gaml)"
            id="net.openchrom.wsd.converter.supplier.gaml.chromatogram"
            importConverter="net.openchrom.wsd.converter.supplier.gaml.converter.ChromatogramImportConverter"
            importMagicNumberMatcher="net.openchrom.xxd.converter.supplier.gaml.converter.MagicNumberMatcher"
            importContentMatcher="net.openchrom.wsd.converter.supplier.gaml.converter.FileContentMatcherChromatogram"
            isExportable="false"
            isImportable="true">
      </ChromatogramSupplier>
   </extension>
      <extension
         point="org.eclipse.chemclipse.wsd.converter.scanSupplier">
      <ScanSupplier
            description="Reads Generalized Analytical Markup Language Scans."
            exportConverter="net.openchrom.wsd.converter.supplier.gaml.converter.ScanExportConverter"
            fileExtension=".gaml"
            filterName="UV/Vis Spectroscopy (*.gaml)"
            id="net.openchrom.wsd.converter.supplier.gaml.spectrum"
            importConverter="net.openchrom.wsd.converter.supplier.gaml.converter.ScanImportConverter"
            importMagicNumberMatcher="net.openchrom.xxd.converter.supplier.gaml.converter.MagicNumberMatcher"
            importContentMatcher="net.openchrom.wsd.converter.supplier.gaml.converter.FileContentMatcherSpectrum"
            isExportable="false"
            isImportable="true">
      </ScanSupplier>
   </extension>
</plugin>
