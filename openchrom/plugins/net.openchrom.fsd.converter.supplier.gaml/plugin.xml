<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
      <extension
         point="org.eclipse.chemclipse.fsd.converter.scanSupplier">
      <ScanSupplier
            description="Reads Generalized Analytical Markup Language Scans."
            exportConverter="net.openchrom.fsd.converter.supplier.gaml.converter.ScanExportConverter"
            fileExtension=".gaml"
            filterName="Fluorescence Spectroscopy (*.gaml)"
            id="net.openchrom.fsd.converter.supplier.gaml.spectrum"
            importConverter="net.openchrom.fsd.converter.supplier.gaml.converter.ScanImportConverter"
            importMagicNumberMatcher="net.openchrom.xxd.converter.supplier.gaml.converter.MagicNumberMatcher"
            importContentMatcher="net.openchrom.fsd.converter.supplier.gaml.converter.FileContentMatcherSpectrum"
            isExportable="false"
            isImportable="true">
      </ScanSupplier>
   </extension>
</plugin>
