<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.openchrom</groupId>
    <artifactId>master</artifactId>
    <version>1.6.26-SNAPSHOT</version>
    <relativePath>../..</relativePath>
  </parent>
  <artifactId>openchrom.compilation.community</artifactId>
  <packaging>eclipse-repository</packaging>
  <name>OpenChrom Compilation Community Product</name>
  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-director-plugin</artifactId>
        <configuration>
          <products>
            <product>
              <id>net.openchrom.rcp.compilation.community.product.id</id>
            </product>
          </products>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>gpg-sign</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-gpg-plugin</artifactId>
            <version>${tycho.version}</version>
            <configuration>
              <keyname>${gpg-keyname}</keyname>
              <signer>bc</signer>
              <skipIfJarsigned>false</skipIfJarsigned>
              <skipIfJarsignedAndAnchored>true</skipIfJarsignedAndAnchored>
            </configuration>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>sign-p2-artifacts</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
